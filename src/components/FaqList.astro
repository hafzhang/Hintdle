---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<section class="faq" aria-label="Frequently asked questions">
  <h2>Frequently asked questions</h2>
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <div class="a">{item.a}</div>
    </details>
  ))}
</section>
