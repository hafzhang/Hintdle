---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import { link } from '../lib/site';
import { getGraph, difficultyOf } from '../lib/graph';
import { breadcrumbLd, webApplicationLd, faqLd } from '../lib/seo';

const { words } = getGraph();
const wordCount = words.size;

const title = 'Poople Solver — Shortest Word Ladder to POOP';
const description = `The Poople solver returns the shortest path from any four-letter word to POOP: the full ladder, how many routes share that length, and every alternative. All ${wordCount.toLocaleString('en-US')} playable words, computed in your browser — nothing is uploaded, no account needed.`;

const faqs = [
  {
    q: 'How does the solver find the shortest ladder?',
    a: 'Every four-letter word is mapped to how many steps it needs to reach POOP. The solver reads that table and prints the canonical shortest ladder plus any equally short alternatives. Because the table is pre-computed, the answer appears the instant you submit a word — there is no search happening while you wait.',
  },
  {
    q: 'What if my word has no ladder?',
    a: `Only words that can genuinely reach POOP are included — all ${wordCount.toLocaleString('en-US')} of them. If you type something else, the solver says so rather than inventing a path, because a wrong ladder is worse than no ladder.`,
  },
  {
    q: 'Is my input sent to a server?',
    a: 'No. The dictionary is a static file downloaded once, and the lookup happens entirely in your browser. Hintdle has no backend and no accounts, so there is nothing to log or store.',
  },
  {
    q: 'Is this the same as Poople unlimited?',
    a: `Effectively yes. Poople unlimited drops the one-puzzle-a-day limit and lets you play any starting word as many times as you want; the solver gives you the shortest path to POOP for any of the ${wordCount.toLocaleString('en-US')} playable words, so every lookup is a round of unlimited practice.`,
  },
  {
    q: 'Can I use it for a word I am stuck on right now?',
    a: 'Yes — that is exactly what it is for. Type your current word to see how many steps remain and the exact sequence that finishes the ladder. If you would rather not see the answer, use the hints page instead.',
  },
];
const jsonLd = [
  webApplicationLd({ name: 'Hintdle Word Ladder Solver', path: '/solver/', description }),
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Solver', path: '/solver/' }]),
  faqLd(faqs),
];
---
<Base title={title} description={description} path="/solver/" jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Solver' }]} />

  <h1>Poople solver: shortest path to POOP from any four-letter word</h1>
  <p class="lede">
    Enter any four-letter word and the Poople solver returns the shortest path to POOP: the exact sequence
    of words, how many other ladders are just as short, and every extra route it can find. It runs
    entirely in your browser against a pre-computed table of {wordCount.toLocaleString('en-US')} words.
  </p>

  <section class="card">
    <form class="solver-form" id="solver-form" autocomplete="off">
      <label class="sr-only" for="solver-input">Four-letter starting word</label>
      <input
        type="text"
        id="solver-input"
        name="word"
        maxlength="4"
        inputmode="latin"
        spellcheck="false"
        placeholder="JUGS"
        aria-describedby="solver-help"
      />
      <button type="submit" id="solver-submit">Solve</button>
    </form>
    <p id="solver-help" class="muted" style="margin-top:-6px">
      Four letters, A–Z. Example: <a href="?word=jugs" data-example="jugs">jugs</a>,
      <a href="?word=rise" data-example="rise">rise</a>,
      <a href="?word=umph" data-example="umph">umph</a>.
    </p>
    <div class="result" id="solver-result" aria-live="polite">
      <p class="muted">Loading the word dictionary…</p>
    </div>
  </section>

  <h2>How the solver works</h2>
  <p>
    The solver is built on a complete graph of four-letter words: two words are connected if they differ
    in exactly one letter. POOP sits at the centre, and every word is tagged with its distance — the
    minimum number of one-letter swaps needed to arrive. All {wordCount.toLocaleString('en-US')} words in
    the graph can reach POOP, with distances ranging from a single move up to
    {Math.max(...[...words.values()].map((w) => w.distance))} moves.
  </p>
  <p>
    When you submit a word, the solver prints the canonical shortest ladder — the chain of words you get
    by repeatedly stepping to a word one level closer to POOP — and then lists any other ladders of the
    same length. Two ladders are equally good only if they share the same number of steps; a route that
    looks smoother but takes one extra step is longer and therefore not a valid substitute.
  </p>
  <p>
    The alternatives matter more than they seem. Many players lose time by fixating on a single route;
    seeing that a word has several optimal openings means you can steer into whichever one you can
    actually spell out. Difficulty labels are attached to every result too: 1–3 steps is
    Easy, 4–5 is Medium, and 6 or more is Hard, matching the way the daily puzzle labels its own
    difficulty.
  </p>

  <h2>Poople unlimited — practice with any word, as often as you like</h2>
  <p>
    Poople unlimited is the same ladder with the daily limit removed: instead of waiting for one starting
    word a day, you pick any of the {wordCount.toLocaleString('en-US')} playable words and play it straight
    away. That is exactly what this solver does — every lookup is one round of unlimited practice. Type a
    word, read how many steps it needs, then try to walk the ladder yourself before you reveal it.
  </p>
  <p>
    Would rather have the word chosen for you? The <a href={link('/unlimited/')}>unlimited practice page</a>
    draws a random starting word and shows the same shortest-path result, so you can keep going without
    deciding anything. Practising this way teaches the shape of the graph faster than replaying the daily
    puzzle once, because you meet words from every distance band, not just today's.
  </p>

  <FaqList items={faqs} />

  <section class="card">
    <h2 style="margin-top:0">Related pages</h2>
    <ul class="linklist">
      <li><a href={link('/answer-today/')}>Today's answer</a></li>
      <li><a href={link('/hints/')}>Today's hints</a></li>
      <li><a href={link('/unlimited/')}>Unlimited practice</a></li>
      <li><a href={link('/from/')}>Word index</a></li>
    </ul>
  </section>
</Base>

<script>
  type Entry = { d: number; c: number; p: string; a: string[] };

  const form = document.getElementById('solver-form') as HTMLFormElement | null;
  const input = document.getElementById('solver-input') as HTMLInputElement | null;
  const result = document.getElementById('solver-result');
  const submit = document.getElementById('solver-submit') as HTMLButtonElement | null;

  let dict: Record<string, Entry> | null = null;
  let loading: Promise<Record<string, Entry>> | null = null;

  function loadDict(): Promise<Record<string, Entry>> {
    if (!loading) {
      loading = fetch('/solver-data.json')
        .then((r) => r.json())
        .then((data) => {
          dict = data as Record<string, Entry>;
          return dict;
        });
    }
    return loading;
  }

  function difficulty(d: number): { label: string; cls: string } {
    if (d <= 3) return { label: 'Easy', cls: 'Easy' };
    if (d <= 5) return { label: 'Medium', cls: 'Medium' };
    return { label: 'Hard', cls: 'Hard' };
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  }

  function render(word: string, data: Record<string, Entry>) {
    if (!result) return;
    const key = word.toLowerCase();
    if (!/^[a-z]{4}$/.test(key)) {
      result.innerHTML = '<p class="error">Please enter exactly four letters (A–Z).</p>';
      return;
    }
    const entry = data[key];
    if (!entry) {
      result.innerHTML = `<p class="error">“${escapeHtml(key.toUpperCase())}” is not one of the playable four-letter words, so it has no ladder to POOP.</p>`;
      return;
    }
    const diff = difficulty(entry.d);
    const rungs = entry.p
      .split(' ')
      .map((w: string) => `<span class="rung">${w.toUpperCase()}</span>`)
      .join('<span class="arrow" aria-hidden="true">→</span>');
    const alts = entry.a.length
      ? `<h3>Other shortest ladders (${entry.c} total)</h3>
         <table><tbody>${entry.a
           .map((p: string) => `<tr><td class="mono">${p.split(' ').map((w) => w.toUpperCase()).join(' → ')}</td></tr>`)
           .join('')}</tbody></table>`
      : '';
    result.innerHTML = `
      <div class="answer-meta">
        <span class="pill strong">${entry.d} step${entry.d === 1 ? '' : 's'}</span>
        <span class="pill diff ${diff.cls}">${diff.label}</span>
        <span class="pill">${entry.c} shortest path${entry.c === 1 ? '' : 's'}</span>
      </div>
      <div class="ladder">${rungs}</div>
      ${alts}
      <p style="margin:10px 0 0"><a href="/from/${key}/">Full analysis for ${key.toUpperCase()} →</a></p>`;
  }

  async function run(word: string) {
    if (submit) submit.disabled = true;
    if (result) result.innerHTML = '<p class="muted">Looking it up…</p>';
    const data = await loadDict();
    render(word, data);
    if (submit) submit.disabled = false;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = input?.value.trim() ?? '';
    if (input) input.value = value.toUpperCase();
    run(value);
  });

  document.querySelectorAll<HTMLElement>('[data-example]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const w = el.getAttribute('data-example') ?? '';
      if (input) input.value = w.toUpperCase();
      run(w);
    });
  });

  // Preload the dictionary as soon as the browser is idle, and auto-solve ?word=xxxx.
  const qs = new URLSearchParams(location.search).get('word');
  if (qs && /^[a-zA-Z]{4}$/.test(qs)) {
    if (input) input.value = qs.toUpperCase();
    run(qs);
  } else {
    const start = () => { void loadDict().then(() => { if (result) result.innerHTML = '<p class="muted">Dictionary ready — enter a word above.</p>'; }); };
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start);
    else setTimeout(start, 800);
  }
</script>
