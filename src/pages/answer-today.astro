---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LadderPath from '../components/LadderPath.astro';
import FaqList from '../components/FaqList.astro';
import { link, upper } from '../lib/site';
import { solveWord, difficultyOf } from '../lib/graph';
import { todayPuzzle, fmtDate } from '../lib/daily';
import { breadcrumbLd, faqLd } from '../lib/seo';

const today = todayPuzzle();
if (!today) {
  throw new Error('No puzzle found for today — data/daily_sequence.csv needs refreshing from a new bundle.');
}

const sol = solveWord(today.word, 12);
const firstTo = sol.best[1];
const changedPos = [...today.word].findIndex((c, i) => c !== firstTo[i]);
const answerText = sol.best.map(upper).join(' → ');

const title = `Poople Answer Today — ${upper(today.word)} to POOP in ${today.distance} Steps`;
const description = `Puzzle #${today.n}: the shortest ladder from ${upper(today.word)} to POOP takes ${today.distance} steps. Full answer, every equal-length alternative and the number of possible paths, updated daily.`;

const faqs = [
  {
    q: `How do you get from ${upper(today.word)} to POOP?`,
    a: `Change one letter at a time and keep every rung a real word: ${answerText}. That is the shortest possible ladder, ${today.distance} steps long.`,
  },
  {
    q: 'Is there more than one shortest answer?',
    a: sol.pathCount === 1
      ? `No — ${upper(today.word)} has exactly one shortest ladder to POOP. Every other route is longer.`
      : `Yes. ${upper(today.word)} has ${sol.pathCount} equally short ladders to POOP. They all take ${today.distance} steps; the site lists them so you can tell whether your route is optimal or just different.`,
  },
  {
    q: `Why does the first move change letter #${changedPos + 1}?`,
    a: `In the shortest ladder the first rung is ${upper(firstTo)}, which differs from ${upper(today.word)} only in position ${changedPos + 1} (${today.word[changedPos].toUpperCase()} becomes ${firstTo[changedPos].toUpperCase()}). Any other first move either wastes a step or lands on a word that cannot reach POOP as quickly.`,
  },
  {
    q: 'When does the next answer go live?',
    a: 'A new puzzle appears at 08:00 UTC (16:00 Beijing time) every day. This page is rebuilt right after the switch, and past puzzles stay in the archive forever.',
  },
];
const jsonLd = [
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: "Today's answer", path: '/answer-today/' }]),
  faqLd(faqs),
];
---
<Base title={title} description={description} path="/answer-today/" jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: "Today's answer" }]} />

  <h1>Poople answer today: {upper(today.word)} to POOP in {today.distance} steps</h1>
  <p class="lede">
    Puzzle #{today.n}, live from {fmtDate(today.startUtc)} at 08:00 UTC. The whole answer is on this
    screen — nothing to click, nothing to expand.
  </p>

  <section class="card answer-card" aria-labelledby="answer">
    <h2 id="answer" style="margin-top:0">The answer</h2>
    <div class="answer-meta">
      <span class="pill strong">{today.distance} steps</span>
      <span class={`pill diff ${difficultyOf(today.distance)}`}>{difficultyOf(today.distance)}</span>
      <span class="pill">{sol.pathCount} shortest path{sol.pathCount === 1 ? '' : 's'}</span>
    </div>
    <LadderPath path={sol.best} />
    <div class="solver-form" style="margin-top:4px">
      <button id="copy-answer" class="ghost" data-answer={answerText}>Copy this ladder</button>
      <span id="copy-status" class="muted" role="status" aria-live="polite"></span>
    </div>
  </section>

  <section class="card">
    <h2 style="margin-top:0">Every shortest path</h2>
    {sol.pathCount === 1 ? (
      <p style="margin:0">
        There is exactly one {today.distance}-step route from {upper(today.word)} to POOP, so the ladder
        above is the only optimal answer.
      </p>
    ) : (
      <>
        <p>
          {upper(today.word)} reaches POOP in {today.distance} steps along
          <strong>{sol.pathCount}</strong> different ladders. Each one below is optimal — pick whichever
          fits the words you have already tried.
        </p>
        <table>
          <thead><tr><th>#</th><th>Ladder</th></tr></thead>
          <tbody>
            {sol.paths.map((p, i) => (
              <tr><td>{i + 1}</td><td class="mono">{p.map(upper).join(' → ')}</td></tr>
            ))}
          </tbody>
        </table>
        {sol.pathCount > sol.paths.length && (
          <p class="muted">
            Showing {sol.paths.length} of {sol.pathCount} ladders — the remainder follow the same pattern
            from the words listed above.
          </p>
        )}
      </>
    )}
  </section>

  <section class="card">
    <h2 style="margin-top:0">Want to solve it yourself?</h2>
    <p>
      The <a href={link('/hints/')}>hint page</a> gives you four escalating clues instead of the answer:
      first the number of steps, then which letter position changes first, then what that letter becomes,
      and finally the first word only. The full ladder stays in a separate section at the bottom so it
      cannot be spoiled by scrolling.
    </p>
  </section>

  <h2>How to read this answer</h2>
  <p>
    Each rung in the ladder differs from the previous one by exactly one letter, and every rung —
    including the awkward-looking ones — is a real four-letter word. That is the whole rule of the game.
    The trick to reading an answer fast is to look at <em>which</em> position changes on each step rather
    than reading the words letter by letter: from {upper(today.word)} the ladder walks
    {sol.best
      .slice(1)
      .map((w, i) => {
        const prev = sol.best[i];
        const pos = [...w].findIndex((c, j) => c !== prev[j]);
        return `position ${pos + 1} (${w[pos].toUpperCase()})`;
      })
      .join(', then ')}. The final move lands on POOP itself, which is the fixed target of every puzzle.
  </p>
  <p>
    If your own attempt took more than {today.distance} steps, the usual cause is a dead end early on: a
    word that looks close to the target but is actually further away. The solver and the per-word pages
    show the distance of every word from POOP, which makes those traps obvious.
  </p>

  <FaqList items={faqs} />

  <section class="card">
    <h2 style="margin-top:0">Related pages</h2>
    <ul class="linklist">
      <li><a href={link('/hints/')}>Poople hints</a></li>
      <li><a href={link(`/from/${today.word}/`)}>{upper(today.word)} ladder page</a></li>
      <li><a href={link('/solver/')}>Solver</a></li>
      <li><a href={link('/archive/')}>Answer archive</a></li>
    </ul>
  </section>
</Base>

<script>
  const btn = document.getElementById('copy-answer');
  const status = document.getElementById('copy-status');
  btn?.addEventListener('click', async () => {
    const text = btn.getAttribute('data-answer') ?? '';
    try {
      await navigator.clipboard.writeText(text);
      if (status) status.textContent = 'Copied!';
    } catch {
      if (status) status.textContent = text;
    }
    setTimeout(() => { if (status) status.textContent = ''; }, 2500);
  });
</script>
